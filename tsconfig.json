{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "types": [
            "bun"
        ]
    },
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "dist"
    ]
}
