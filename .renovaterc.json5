{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  semanticCommitType: "fix",
  packageRules: [
    {
      matchDatasources: ["npm"],
      groupName: "npm",
      groupSlug: "npm",
    },
    {
      matchDatasources: ["docker"],
      groupName: "docker",
      groupSlug: "docker",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "actions",
      groupSlug: "actions",
    },
  ],
}
